<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:paddingLeft="0dp"
        android:paddingTop="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:background="@android:color/black">

        <com.termux.x11.LorieView
            android:id="@+id/lorieView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:id="@+id/x11_image"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_x11_icon"
                android:contentDescription="X Logo"
                tools:ignore="HardcodedText" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="20dp" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:text="@string/not_connected"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="20dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/preferences_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_extra_key_settings"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/preferences_button_text" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/displays_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/lorie_ic_displays"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/displays_button_text" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/help_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/lorie_ic_help"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/help_button_text" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/exit_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/lorie_ic_exit"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/exit_button_text" />
            </LinearLayout>
        </LinearLayout>


    </FrameLayout>

    <LinearLayout
        android:id="@+id/mouse_helper_visibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="0px"
        android:translationY="0px">

        <Button
            android:id="@+id/button_visibility"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:minWidth="44dip"
            android:minHeight="22dip"
            android:padding="0px"
            android:paddingStart="0px"
            android:paddingLeft="0px"
            android:paddingTop="0px"
            android:paddingEnd="0px"
            android:paddingRight="0px"
            android:paddingBottom="0px"
            android:text="X"
            android:textSize="8sp"
            tools:ignore="HardcodedText,PxUsage,SmallSp" />

        <LinearLayout
            android:id="@+id/mouse_helper_secondary_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:visibility="visible">

            <Button
                android:id="@+id/button_left_click"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="44dip"
                android:minHeight="22dip"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="L"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/button_middle_click"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="44dip"
                android:minHeight="22dip"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="M"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/button_right_click"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="44dip"
                android:minHeight="22dip"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="R"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mouse_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:orientation="vertical"
        android:alpha="0.7"
        android:translationX="0px"
        android:translationY="0px">

        <LinearLayout
            android:id="@+id/mouse_buttons_secondary_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:visibility="visible">

            <Button
                android:id="@+id/mouse_button_left_click"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="L"
                android:textColor="@android:color/black"
                android:background="@drawable/mouse_buttons"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/mouse_button_middle_click"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="M"
                android:textColor="@android:color/black"
                android:background="@drawable/mouse_buttons"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/mouse_button_right_click"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="R"
                android:textColor="@android:color/black"
                android:background="@drawable/mouse_buttons"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mouse_buttons_position"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:adjustViewBounds="true"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="MOVE"
            android:layout_gravity="center"
            android:background="@drawable/mouse_buttons"
            tools:ignore="HardcodedText,PxUsage,SmallSp" />
    </LinearLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/terminal_toolbar_view_pager"
        android:visibility="gone"
        android:pointerIcon="arrow"
        android:layout_width="match_parent"
        android:layout_height="37.5dp"
        android:background="@android:color/black"
        android:layoutDirection="ltr"
        android:layout_gravity="bottom|center"/>

    <TextView
        android:id="@+id/no_server_signal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:background="@drawable/no_server_signal_background"
        android:clickable="false"
        android:focusable="false"
        android:text="@string/no_server_signal"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:layout_gravity="bottom|center" />

    <!--
      桌面控制悬浮按钮。
      X11 界面是全屏的 Linux 桌面，没有抽屉可滑，这里必须有一个常驻入口，
      否则用户在里面没有任何办法重启/关闭系统。
    -->
    <TextView
        android:id="@+id/pad_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:alpha="0.6"
        android:background="#B3000000"
        android:contentDescription="桌面控制菜单"
        android:gravity="center"
        android:text="≡"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/pad_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="14dp"
        android:background="#EE151515"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pad_panel_lifecycle"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="随 App 关闭：开 ✓"
            android:textColor="#7ED37E"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="#44FFFFFF" />

        <!--
          导航项：当前已在 X11 桌面，这里唯一该做的就是「回终端」。
          （旧版这里放「进入桌面」，在桌面里点它毫无意义，已移除）
        -->
        <TextView
            android:id="@+id/pad_panel_termux"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="终端模式"
            android:textColor="#8FC7FF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_restart"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="重启系统"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_audio"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="重启音频"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_mountsd"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="挂载 SD 卡"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_import"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="导入系统包"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_backup"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="备份系统"
            android:textColor="#8FC7FF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_restore"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="恢复备份"
            android:textColor="#8FC7FF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/pad_panel_scale"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="界面缩放 200%"
            android:textColor="#8FC7FF"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <!-- 破坏性操作固定放最底下，避免误触 -->
        <TextView
            android:id="@+id/pad_panel_stop"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="关闭系统"
            android:textColor="#FF7A7A"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</FrameLayout>
