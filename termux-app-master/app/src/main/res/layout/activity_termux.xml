<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <!-- 标题色条：Ubuntu 橙，一眼能认出这是菜单，和黑底终端区分开 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#E95420"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="Termux 菜单"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@null"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="?attr/termuxActivityDrawerImageTint" />
                </LinearLayout>

                <!-- Ubuntu 桌面控制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_desktop_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="进入桌面"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_desktop"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_restart_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="重启系统"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_restart"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_audio_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="音频"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_audio"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_import_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="导入"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_import"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_stop_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="关闭系统"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_stop"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_lifecycle_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="随 App 关闭 ✓"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_lifecycle"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_mountsd_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="挂载下载"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_mount"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_scale_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:paddingHorizontal="2dp"
                        android:textSize="11sp"
                        android:text="界面缩放 200%"
                        android:minHeight="56dp"
                        app:icon="@drawable/ic_pad_scale"
                        app:iconGravity="textTop"
                        app:iconSize="22dp"
                        app:iconPadding="2dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:background="@color/black"
            android:layout_alignParentBottom="true" />

        <!--
          Termux 的抽屉原生只有两个入口：Ctrl+Alt+→ 和额外按键栏的 DRAWER 键。
          两者在平板上都不可用，所以这里放一个常驻的可见按钮。
        -->
        <Button
            android:id="@+id/pad_drawer_button"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="4dp"
            android:layout_marginTop="4dp"
            android:alpha="0.55"
            android:background="#A6000000"
            android:contentDescription="打开菜单"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="≡"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
